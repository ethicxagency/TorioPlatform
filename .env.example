# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- URLs ---
WEB_URL=http://localhost:3000
# Public origin of the API. OAuth callbacks (Google) are built from this, never from WEB_URL. Required in production unless GOOGLE_REDIRECT_URI is set.
API_URL=http://localhost:4000
API_PORT=4000
# Comma-separated explicit CORS allowlist
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Browser-visible API base (Next.js). Leave unset on Vercel: the API is served from the same domain at /api.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL (docker-compose or local install) ---
POSTGRES_USER=torio
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=torio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://torio:change-me-local-only@localhost:5432/torio?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Set true to make /health/ready fail when Redis is down
REDIS_REQUIRED=true

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# --- Customer sign-in with Google / Facebook (optional; see docs/CUSTOMER_AUTH.md). A provider without both of its values is not offered. ---
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback      # production default: <WEB_URL>/api/v1/auth/oauth/google/callback
# FACEBOOK_APP_ID=...                  # a Meta app with the "Facebook Login" product; separate from the META_* channel app
# FACEBOOK_APP_SECRET=...
# FACEBOOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/facebook/callback  # production default: <WEB_URL>/api/v1/auth/oauth/facebook/callback
# FACEBOOK_LOGIN_CONFIG_ID=...          # only if the Meta app is "Facebook Login for Business": permissions then come from this Login Configuration (no scope is sent)

# --- Transactional email (optional). Without both, verification and password-reset emails cannot be sent and the UI says so. ---
# RESEND_API_KEY=re_...
# MAIL_FROM="Torio <no-reply@yourdomain.com>"   # a sender verified in Resend

# --- Billing (optional). Without STRIPE_SECRET_KEY the Billing page works read-only and nothing can be bought. ---
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...      # required with the key; webhooks go to POST /api/v1/billing/webhooks/stripe
# BILLING_PRICE_IDS={"starter":{"month":"price_...","year":"price_..."},"growth":{"month":"price_...","year":"price_..."},"scale":{"month":"price_...","year":"price_..."}}

# Meta settings below are now managed in Super Admin → Integrations → Meta Developer; the values here are the fallback.
# --- WhatsApp Cloud API (optional). Without all three, WhatsApp can't be connected and the UI says so. See docs/WHATSAPP.md ---
# META_APP_ID=...                      # numeric Meta app id (needed for Messenger / Instagram OAuth)
# META_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/channels/meta/callback   # must match Meta app settings exactly
# META_WA_CONFIG_ID=...                # optional: WhatsApp Embedded Signup configuration id
# META_DISCOVER_WHATSAPP=false          # true: the Facebook login also lists existing WhatsApp numbers (needs whatsapp_business_management/messaging + business_management approved)
# META_APP_SECRET=...                  # signs webhooks (X-Hub-Signature-256)
# META_WEBHOOK_VERIFY_TOKEN=...        # the token you enter in Meta's webhook setup
# CHANNEL_ENCRYPTION_KEY_PREVIOUS=...  # only while rotating the key; then Super Admin → Meta Developer → Security → Re-encrypt
# CHANNEL_ENCRYPTION_KEY=...           # >= 32 chars; encrypts stored provider tokens
# META_GRAPH_VERSION=v27.0            # check developers.facebook.com/docs/graph-api/changelog (v21.0 ends Jan 2027)

# Brain imports (optional, all off by default; see docs/BRAIN-IMPORTS.md)
# ANTHROPIC_API_KEY=...                 # lets website scans also structure page text with Claude
# CRON_SECRET=...                       # 16+ chars; lets a scheduler call /api/v1/internal/imports/tick
# META_CATALOG_ENABLED=false            # true only after Meta App Review grants catalog_management
# GOOGLE_MERCHANT_ENABLED=false         # true only after Google verifies the Merchant API scope
# GOOGLE_MERCHANT_REDIRECT_URI=http://localhost:4000/api/v1/brain/imports/google/callback

# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- URLs ---
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
# Comma-separated explicit CORS allowlist
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Browser-visible API base (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL (docker-compose or local install) ---
POSTGRES_USER=torio
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=torio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://torio:change-me-local-only@localhost:5432/torio?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Set true to make /health/ready fail when Redis is down
REDIS_REQUIRED=true

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
